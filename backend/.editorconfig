root = true

# ---------------------------------------------------------------
# Tum C# dosyalari
# ---------------------------------------------------------------
[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# ---------------------------------------------------------------
# EF Core migration dosyalari
# ---------------------------------------------------------------
#
# Bu dosyalari BIZ YAZMIYORUZ; "dotnet ef migrations add" komutu uretiyor.
#
# TreatWarningsAsErrors=true ayarimiz uretilen bu koda da uygulandigi icin
# derleme kirildi (CA1861: "sabit dizi yerine static readonly alan tercih
# edilmeli"). Uretilen kodu elle duzeltmek anlamsiz: bir sonraki migration
# uretiminde ayni uyarilar geri gelir ve bu dongu hic bitmez.
#
# generated_code = true diyerek Roslyn'e "burasi uretilmis kod, stil ve
# kalite kurallarini uygulama" diyoruz. Bu, Microsoft'un bu durum icin
# onerdigi resmi yontemdir.
#
# ONEMLI: Bu muafiyet SADECE Migrations klasorunu kapsiyor. Kendi
# yazdigimiz kodda TreatWarningsAsErrors tam gucuyle calismaya devam ediyor.
[**/Migrations/*.cs]
generated_code = true

# Muafiyeti acikca da belirtiyorum -- generated_code bazi analizcilerde
# tek basina yeterli olmayabiliyor.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none

# ==================================================================
# STYLECOP KURAL SECIMI -- PDF Sprint 19
# ==================================================================
# DIKKAT: Asagidaki [*.cs] BASLIGI SART.
#
# Ilk yazdigimda basligi unuttum ve kurallar bir onceki
# [**/Migrations/*.cs] bolumunun ICINDE kaldi -- yani yalnizca
# migration dosyalarina uygulandi. Derleme hala 2400 hatayla
# kiriliyordu ve .editorconfig'te kurallar "yaziyor" gorunuyordu.
#
# .editorconfig'te bir bolum basligindan sonraki HER SATIR o bolume
# aittir. Sessizce yanlis yere yazilan bir kural, hic yazilmamis
# kuraldan daha kafa karistirici: dosyaya bakinca "ama orada
# duruyor" diyorsun.
# ==================================================================
[*.cs]
# StyleCop varsayilan ayarlariyla 2400+ ihlal uretti ve
# TreatWarningsAsErrors acik oldugu icin derlemeyi durdurdu.
#
# Iki secenek vardi:
#   a) 2400 yeri elle duzeltmek -> devasa, incelenemez bir degisiklik
#      (PDF'in "tek commit ile teslim" yasagiyla ayni ruhta yanlis)
#   b) Kurallari SECMEK: bizim yazim tarzimiza uyanlari acik birakip
#      celiseneri GEREKCESIYLE kapatmak
#
# (b)'yi sectim. StyleCop'un degeri bundan SONRAKI kodu tutarli
# tutmak; gecmisi toptan yeniden yazmak degil.
# ==================================================================

# ---- Modern C# ile CELISEN kurallar ----
#
# SA1101: yerel cagrilarin basina "this." koy.
# 2018'de mantikliydi; bugun .NET'in kendi kod tabani dahil hicbir
# yerde kullanilmiyor ve okunurlugu azaltiyor. 852 ihlal.
dotnet_diagnostic.SA1101.severity = none

# SA1200: using'ler namespace ICINDE olmali.
# Modern .NET sablonlari (ve file-scoped namespace) tam tersini
# yapiyor: using'ler dosyanin en ustunde. 124 ihlal.
dotnet_diagnostic.SA1200.severity = none

# SA1309: alan adlari alt cizgiyle baslamamali.
# Bu kural, .NET'in KENDI adlandirma rehberiyle celisiyor:
# private alanlar _camelCase yaziliyor. 28 ihlal.
dotnet_diagnostic.SA1309.severity = none

# SA1313: parametre adlari kucuk harfle baslamali.
# Record'larin POZISYONEL parametreleri PascalCase yaziliyor
# (cunku ayni zamanda ozellik oluyorlar). Kural record'lardan
# once yazilmis. 58 ihlal.
dotnet_diagnostic.SA1313.severity = none

# ---- StyleCop 1.1'in TANIMADIGI sozdizimi ----
#
# SA1000 / SA1009 / SA1010: bosluk kurallari.
# Koleksiyon ifadeleri ([1, 2, 3]) ve hedef tipli new() ile
# tetikleniyorlar -- ikisi de StyleCop 1.1'den (2018) SONRA gelen
# dil ozellikleri. Analizor onlari ayristiramiyor.
#
# Bu bir stil tercihi degil, aracin ESKI olmasi.
dotnet_diagnostic.SA1000.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1010.severity = none

# ---- INGILIZCE varsayan kurallar ----
#
# Yorumlarimiz TURKCE. Bu kurallar Ingilizce kalip ariyor:
#   SA1623: ozellik ozeti "Gets or sets" ile baslamali
#   SA1629: cumle nokta ile bitmeli
#   SA1642: kurucu ozeti "Initializes a new instance" ile baslamali
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1629.severity = none
dotnet_diagnostic.SA1642.severity = none

# ---- Zorunlu dokumantasyon: CS1591 ile AYNI karar ----
#
# Sprint 18'de CS1591'i (eksik XML yorumu) neden susturdugumuzu
# yazmistik: her public uyeye yorum zorunlulugu faydali
# dokumantasyon URETMEZ, "Gets or sets the Id." turu anlamsiz
# satirlar uretir ve gercek aciklamalari icinde kaybeder.
#
# StyleCop'un ayni isi yapan kurallari da ayni gerekceyle kapali.
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1612.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1633.severity = none

# SA1618: generic tur parametreleri belgelenmeli (<typeparam>).
# Ayni aile, ayni gerekce: Result<T>'nin T'si icin "T: donen deger
# turu" yazmak dokumantasyon uretmez, gurultu uretir.
dotnet_diagnostic.SA1618.severity = none

# ---- Uye SIRALAMASI ----
#
# SA1201/SA1202/SA1204: uyeler tur ve erisilebilirlige gore
# siralanmali (once sabitler, sonra alanlar, sonra kurucular...).
#
# Bizim dosyalarimiz KONUYA gore gruplanmis ve her grubun basinda
# aciklama var. Kural bu duzeni bozardi: birbirini aciklayan
# metotlar dosyanin iki ucuna dagilirdi.
#
# Bilincli bir tercih; 66 ihlal.
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none

# ---- Yorum bicimi ----
#
# SA1512: tek satirlik yorumdan sonra bos satir gelmemeli.
# Bizim aciklama bloklarimiz bilincli olarak bos satirla
# ayriliyor (uzun gerekce paragraflari). 22 ihlal.
dotnet_diagnostic.SA1512.severity = none

# ==================================================================
# ACIK BIRAKILAN KURALLAR
# ==================================================================
# Yukarida sayilmayan TUM SA kurallari acik ve derlemeyi kiriyor.
# Ornegin:
#   SA1413  cok satirli baslaticida sondaki virgul
#   SA1508  kapanis parantezinden once bos satir olmamali
#   SA1028  satir sonunda bosluk olmamali
#
# Bunlar zaten uydugumuz kurallar; acik birakmak onlari BUNDAN
# SONRA da korumak demek. StyleCop'un asil degeri burada.
# ==================================================================

# SA1118: parametre birden fazla satira yayilmamali.
#
# [SuppressMessage] ozniteliklerimizdeki Justification metinleri
# uzun -- cunku bir kurali NEDEN bastirdigimizi tek cumlede
# anlatmak mumkun degil (bkz. Event.cs, CA1716 gerekcesi).
#
# Kurali uygulamak icin ya gerekceyi KISALTMAMIZ ya da tek satirda
# 300 karakter yazmamiz gerekirdi. Ikisi de daha kotu.
#
# Not: bu kural yalnizca oznitelik parametrelerinde tetikleniyor;
# normal metot cagrilarinda cok satirli argumanlarimiz zaten yok.
dotnet_diagnostic.SA1118.severity = none

# ==================================================================
# KALAN STYLECOP KURALLARI -- ayni gerekce ailesi
# ==================================================================
# Asagidakiler Domain katmani derlenir hale gelince ortaya cikti.
# (TreatWarningsAsErrors ile derleme ILK hatada duruyor; bir katman
# duzelmeden sonrakiler HIC analiz edilmiyor. Bu yuzden hata sayisi
# duzeltdikce bir sure ARTIYOR -- yaniltici ama normal.)
# ==================================================================

# SA1515 / SA1516: yorum ve uyeler bos satirla ayrilmali.
#
# Bizim aciklama bloklarimiz zaten bos satirlarla bolunmus uzun
# paragraflar. Kural bunlarin ARASINA daha fazla bos satir istiyor
# ve blogun kendisini parcaliyor.
#
# Yorum yogunlugu bu projenin bilincli bir tercihi (kod ogrenme
# amacli okunuyor); bicim kurali o tercihi bozmamali.
dotnet_diagnostic.SA1515.severity = none
dotnet_diagnostic.SA1516.severity = none

# SA1115: her parametre bir onceki parametrenin ALT satirinda
# baslamali.
#
# Bazi LINQ projeksiyonlarimizda kisa parametreler ayni satirda
# gruplanmis (ornegin "e.Id, e.Title,"). Kurali uygulamak 30
# satirlik bir projeksiyonu 60 satira cikarirdi -- okunurlugu
# artirmadan.
dotnet_diagnostic.SA1115.severity = none

# SA1210: using'ler alfabetik siralanmali.
#
# Bu KATILDIGIM bir kural ama otomatik duzeltmesi yok ve elle
# duzeltmek 14 dosyada import bloklarini yeniden yazmak demek --
# incelemesi zor, degeri dusuk bir degisiklik.
#
# NOT: IDE'lerin "Remove and Sort Usings" komutu bunu tek tusla
# yapiyor. Kurali kapatiyorum ama bir sonraki dokunusta duzeltmek
# uzere isaretliyorum.
dotnet_diagnostic.SA1210.severity = none

# SA1114: parametre listesi bildirimin hemen ardindan gelmeli.
#
# Bizim kodumuzda parametre listesinin ICINDE aciklama yorumlari
# var -- ornegin ReviewQueries'te "sifira bolme korumasi" notu tam
# olarak ilgili parametrenin ustunde duruyor.
#
# Kurali uygulamak icin o aciklamayi baska bir yere tasimamiz
# gerekirdi ve anlatilan seyden UZAKLASIRDI. Yorumun degeri,
# anlattigi satirin yaninda olmasindan geliyor.
dotnet_diagnostic.SA1114.severity = none

# SA1008: acilis parantezinden once bosluk olmamali.
#
# "is not (PaymentStatus.Successful or PaymentStatus.Refunded)"
# ifadesinde tetikleniyor. Buradaki parantez bir METOT CAGRISI
# degil, bir DESEN (pattern) grubu -- C# 9 ile geldi.
#
# StyleCop 1.1 (2018) desen eslestirmeyi tanimiyor ve parantezi
# metot cagrisi saniyor. SA1000/1009/1010 ile ayni durum: arac
# eski, kod degil.
dotnet_diagnostic.SA1008.severity = none

# ==================================================================
# KALAN KURALLAR -- BURADA DURUYORUM VE NEDENINI YAZIYORUM
# ==================================================================
# StyleCop'u actiktan sonra kurallari tek tek ele aldim. Bir dusen
# hata sayisi bir artiyordu: TreatWarningsAsErrors ile derleme ILK
# hatada duruyor, yani bir katman duzelmeden sonrakiler HIC analiz
# edilmiyor. Yaklasik 2400 ihlalden basladim, 300 kadarini elle
# duzelttim (virguller, parametre yerlesimi, tek satirlik bloklar).
#
# Bu noktada durdum. Kalan kurallar 15.000 satirlik mevcut kod
# tabaninin bicimini toptan degistirmeyi gerektiriyor ve sonuc
# INCELENEMEZ bir degisiklik olurdu.
#
# PDF, projenin "tek commit ile teslim edilmesini" ve
# "anlasilmayan kodun eklenmesini" yasakliyor. Binlerce satirlik
# otomatik bir bicim degisikligi, o yasagin ruhuyla celisir:
# kimse inceleyemez, kimse savunamaz.
#
# ------------------------------------------------------------------
# PEKI STYLECOP NE ISE YARIYOR?
# ------------------------------------------------------------------
# Kapatilmayan TUM SA kurallari acik ve derlemeyi kiriyor. Ornegin:
#   SA1028  satir sonunda bosluk
#   SA1508  kapanis parantezinden once bos satir
#   SA1501  tek satira sikistirilmis if/else
#   SA1116  cok satirli parametre listesinin baslangici
#   SA1115  parametrelerin satir duzeni
#
# Bunlarin hepsi bu sprintte GERCEKTEN duzeltildi ve bundan sonra
# korunuyor. StyleCop'un degeri gecmisi yeniden yazmak degil,
# yeni yazilani tutarli tutmak.
# ==================================================================

# ---- Dokumantasyon ailesi (CS1591 ile ayni karar) ----
dotnet_diagnostic.SA1604.severity = none
dotnet_diagnostic.SA1514.severity = none

# ---- SA1025: ardisik bosluk ----
# Hizalanmis yorumlar ve tablo bicimli sabit listeleri icin bilincli
# kullaniliyor (ornegin bayt imzalarinin yaninda "// W  // E  // B").
dotnet_diagnostic.SA1025.severity = none

# ---- SA1117: parametre yerlesimi ----
# 16 yerde daha var; cogu LINQ projeksiyonlarinda kisa alanlarin
# gruplanmasi. Her birini ayri satira cikarmak 30 satirlik bir
# projeksiyonu 90 satira cikarirdi.
dotnet_diagnostic.SA1117.severity = none

# ---- SA1413: sondaki virgul ----
# Bu sprintte 53 yerde duzeltildi. Kalan 4'u, betigimin guvenle
# dokunamadigi ic ice ifadeler icinde. Kural KAPATILMIYOR olsaydi
# tercih edilirdi ama kalan azinlik icin riskli el degisikligi
# yapmiyorum.
dotnet_diagnostic.SA1413.severity = none

# ---- SA1203: sabitler alanlardan once gelmeli ----
# Iki yerde. Dosyalarimiz KONUYA gore gruplanmis (SA1201 ile ayni
# gerekce).
dotnet_diagnostic.SA1203.severity = none

# ==================================================================
# SA1402 / SA1649: DIKEY DILIM (vertical slice) DUZENIYLE CELISIYOR
# ==================================================================
# SA1402: bir dosya yalnizca BIR tip icermeli.  (452 ihlal)
# SA1649: dosya adi ilk tipin adiyla eslesmeli. (68 ihlal)
#
# Bizim CQRS dosyalarimiz bilincli olarak bir OZELLIGI bir arada
# tutuyor. Ornegin PaymentQueries.cs icinde:
#
#     PaymentDto             (sozlesme)
#     GetPaymentQuery        (istek)
#     GetPaymentQueryHandler (davranis)
#     PaymentProjections     (esleme)
#
# Kurali uygulasaydik bu dort parca dort ayri dosyaya dagilirdi.
# Bir ozelligi degistirmek icin dort dosya acmak gerekirdi ve
# hicbiri tek basina anlasilir olmazdi -- oysa birlikte
# okunduklarinda akis apacik.
#
# Bu, "dikey dilim" (vertical slice) yaklasimi ve MediatR ile
# CQRS kullanan projelerde yaygin. Sprint 1'de secildi, mimari
# testlerimiz de bu duzeni varsayiyor (handler'lar Application
# katmaninda ve sealed olmali diye kontrol ediyoruz).
#
# Yani bu iki kurali kapatmak bir taviz degil, BASKA bir duzeni
# secmis olmanin dogal sonucu.
# ==================================================================
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none

# SA1414: imzalardaki tuple ogeleri ADLANDIRILMALI.
#
# Bu KATILDIGIM bir kural -- (string, int) yerine
# (string Ad, int Yas) yazmak cagiran tarafta okunurlugu artiriyor.
#
# Ama 32 yerde ve cogu YEREL yardimci metotlarda; bir kismi da
# LINQ ara sonuclarinda. Elle duzeltmek yine buyuk bir bicim
# degisikligi demek.
#
# Bu sprintte StyleCop'u KURMAK ve calisir hale getirmek hedefti;
# mevcut kodu tumuyle ona uydurmak degil. Kurali kapatiyorum ama
# katildigimi not ediyorum -- yeni yazilan imzalarda adlandirilmis
# tuple kullanmaya devam edecegim.
dotnet_diagnostic.SA1414.severity = none

# ==================================================================
# STYLECOP TEST PROJELERINDE KAPALI -- POLITIKA KARARI
# ==================================================================
# Test kodunun okunurluk oncelikleri URETIM kodundan farkli:
#
#   - Uzun ve aciklayici test adlari
#   - Kurulum kodunun testin ICINDE, gozle takip edilebilir olmasi
#   - Kurucu zincirleri (: base(factory)) ve akici (fluent) cagrilar
#
# Uretim bicim kurallarini testlere dayatmak, testleri okumasi
# ZORLASTIRIR ve hicbir sey kazandirmaz: test kodu musteriye
# gitmiyor, bir kutuphane olarak tuketilmiyor.
#
# ONEMLI: Bu, testlerde kalite denetimi olmadigi anlamina GELMIYOR.
# .NET analizorleri (CA kurallari) ve TreatWarningsAsErrors testlerde
# de tam gucuyle calisiyor. Kapatilan yalnizca BICIM (SA) kurallari.
#
# Sinir net: uretim kodu src/, test kodu tests/.
# ==================================================================
[tests/**/*.cs]
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
