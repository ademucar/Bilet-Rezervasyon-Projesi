<Project>
  <!--
    Merkezi Paket Yonetimi (Central Package Management).

    Kural: .csproj dosyalarinda <PackageReference Include="X" /> yazilir,
    SURUM YAZILMAZ. Surum sadece burada <PackageVersion> ile tanimlanir.

    Neden: 8 projemiz var. Ayni paketin (ornegin EF Core) iki projede farkli
    surumde referanslanmasi, calisma zamaninda cok zor teshis edilen hatalara
    yol acar (diamond dependency). Burasi tek dogru kaynak.

    Yeni paket eklerken:  dotnet add <proje> package <ad>
    CLI surumu otomatik olarak buraya yazar.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- ===================== WEB API ===================== -->
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.18" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.3.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!--
      EF Core cekirdek paketlerini ACIKCA sabitliyorum.

      NEDEN? Npgsql.EntityFrameworkCore.PostgreSQL 9.0.4, gecisli
      (transitive) bagimlilik olarak EF Core 9.0.1 cekiyor.
      Microsoft.EntityFrameworkCore.Design ise 9.0.11.

      Ikisi ayni assembly'nin farkli surumlerini istedigi icin derleyici
      MSB3277 uyarisi verdi: "cakisan surumler cozumlendi".

      Bu, tam olarak Directory.Packages.props'un onlemek icin var oldugu
      "diamond dependency" problemidir. Uyari gorunuste zararsizdir ama
      calisma zamaninda MethodNotFoundException gibi tesbisi cok zor
      hatalara yol acabilir - cunku derlenen surumle yuklenen surum
      farkli olur.

      Cozum: surumu tek bir noktadan sabitlemek.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.11" />
  </ItemGroup>
  <!-- ===================== TEST ALTYAPISI ===================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!--
      FluentAssertions surumunu 7.2.0'a SABITLEDIM, 8.x'e cikarmadim.
      Sebep: 8.0 surumuyle birlikte lisans degisti; ticari kullanim ucretli
      hale geldi. 7.x hala Apache 2.0 ve tum ihtiyacimizi karsiliyor.
      Bunu bilerek yaptim; surumu yukseltmeden once lisansi kontrol et.
    -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <!-- Katman kurallarini test etmek icin -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>