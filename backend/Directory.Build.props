<Project>

  <!--
    Bu dosya, alt klasorlerdeki TUM .csproj dosyalarina otomatik olarak uygulanir.
    MSBuild, bir projeyi derlerken klasor agacinda yukari dogru yurur ve
    bulduğu ilk Directory.Build.props dosyasini projenin en basina ekler.

    Boylece "net9.0" gibi ayarlari 8 ayri csproj'da tekrarlamiyorum.
    Ileride .NET 10'a gecmek istersek tek satir degistirecegiz.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <!--
      Nullable reference types: string? ile string arasindaki farki derleyici
      zorunlu kilar. Null kontrolu unutuldugunda derleme uyarisi aliriz.
      NullReferenceException'larin buyuk kismi daha kod yazilirken yakalanir.
    -->
    <Nullable>enable</Nullable>

    <!--
      System, System.Linq, System.Collections.Generic gibi namespace'ler her
      dosyaya otomatik eklenir. Her dosyanin basindaki 10 satirlik using
      yiginini ortadan kaldirir.
    -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Uyarilari HATA olarak isle.
      Bunu bilerek aciyorum: "0 hata ile guzel bir proje" hedefimiz var.
      Uyarilar birikirse kimse okumaz ve gercek problem gorulmez hale gelir.
      Derleme kirilirsa uyariyi duzeltmek zorunda kalirsin. Disiplin saglar.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      .NET'in yerlesik kod analizcileri. "latest-recommended" seviyesi,
      performans ve dogruluk konusunda anlamli uyarilar verir.
      PDF Sprint 19'da ".NET Analyzer" zorunlu tutuluyor.
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Merkezi paket yonetimi: paket surumleri Directory.Packages.props'ta
      tek yerde tutulur. Ayni paketin iki projede farkli surumde olmasi
      (diamond dependency) sorununu bastan engeller.
    -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      XML DOKUMANTASYON DOSYASI (PDF Sprint 18)

      Sprint 18'e kadar kapaliydi. Simdi ACIYORUZ cunku Swagger,
      "endpoint aciklamalari" ve "response ornekleri" maddelerini
      bu dosyadan okuyor.

      Yani kodun icindeki /// yorumlari, uretilen OpenAPI belgesine
      ve Swagger arayuzune dogrudan gecmis oluyor. Aciklamalari ayri
      bir yerde tutsaydik ikisi zamanla ayrisirdi: kod degisir,
      dokumantasyon eski kalirdi.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CS1591 SUSTURULUYOR: "eksik XML yorumu"

      TreatWarningsAsErrors acik oldugu icin bu uyari derlemeyi
      DURDURUR. Susturmasaydik her public tipe ve uyeye /// yorum
      yazmamiz gerekirdi - yuzlerce DTO alani dahil.

      Bu, faydali dokumantasyon URETMEZ; "Gets or sets the Id."
      turu anlamsiz satirlar uretirdi ve gercek aciklamalari
      icinde kaybederdi.

      Yaklasimimiz: aciklamayi ANLAMLI oldugu yere yaziyoruz
      (endpoint'ler, is kurallari, tuzaklar) ve derleyiciden
      zorunluluk beklemiyoruz.
    -->
    <!--
      CS1573 de susturuluyor: "bazi parametrelerin param etiketi yok"

      Bu kural, bir metodun BIR parametresini belgelediginde
      HEPSINI belgelemeni zorunlu kiliyor.

      Bizim yazim tarzimizla celisiyor: yalnizca ACIKLAMA GEREKTIREN
      parametreyi belgeliyoruz. Ornegin Reservation.Create'te
      lockDuration'in neden disaridan geldigini anlatiyoruz ama
      userId icin "kullanicinin kimligi" yazmanin bir degeri yok.

      Kural yuzunden ya anlamsiz satirlar eklerdik ya da anlamli
      olani SILERDIK. Ikisi de dokumantasyonu kotulestirirdi.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!-- ============ KOD DUZENI (PDF Sprint 19) ============ -->
  <ItemGroup>
    <!--
      PrivateAssets="all": StyleCop yalnizca DERLEME zamaninda
      calisiyor. Bu olmadan, projemize referans veren baska bir
      proje de StyleCop'u miras alirdi; oysa bu bizim ic
      kalite tercihimiz, tuketicimizin sorunu degil.
    -->
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
