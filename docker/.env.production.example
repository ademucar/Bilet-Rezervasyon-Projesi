# ==================================================================
# YAYIN ORTAMI DEGISKENLERI -- ORNEK
# ==================================================================
# Bu dosyayi sunucuda `.env.production` adiyla kopyalayip
# doldurun. `.env.production` .gitignore'da: ICINDE GERCEK
# PAROLALAR OLACAK, asla depoya girmemeli.
#
#   cp .env.production.example .env.production
#   nano .env.production
#   chmod 600 .env.production      # yalnizca sahibi okuyabilsin
#
# Calistirma:
#   docker compose -f docker-compose.prod.yml \
#                  --env-file .env.production up -d
# ==================================================================

# ------------------------------------------------------------------
# ALAN ADI
# ------------------------------------------------------------------
# Caddy sertifikayi BU ada gore aliyor. Alan adinin A kaydi
# sunucunun IP'sine bakiyor olmali, yoksa Let's Encrypt dogrulamasi
# basarisiz olur ve site HTTPS'siz kalir.
#
# www'yu de istiyorsaniz Caddyfile'in ilk satirini
# "site.com, www.site.com" yapin.
SITE_DOMAIN=biletim.example.com

# ------------------------------------------------------------------
# VERITABANI
# ------------------------------------------------------------------
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
# Uretin, dusunmeyin:  openssl rand -base64 32
POSTGRES_PASSWORD=DEGISTIR_uretilmis_uzun_parola

# ------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------
REDIS_PASSWORD=DEGISTIR_uretilmis_uzun_parola

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
# EN AZ 32 KARAKTER. Bu deger sizdiginda saldirgan istedigi
# kullanici ve rol icin gecerli token uretebilir -- parola bilmesine
# gerek kalmaz. Veritabani parolasindan daha kritik.
#
#   openssl rand -base64 48
#
# Degistirdiginizde herkesin oturumu kapanir; bu beklenen davranis.
JWT_SECRET=DEGISTIR_en_az_32_karakter_rastgele_deger
JWT_ISSUER=Ticketing.Api
JWT_AUDIENCE=Ticketing.Client

# ------------------------------------------------------------------
# E-POSTA
# ------------------------------------------------------------------
# YAYINDA MAILPIT KULLANMAYIN. Mailpit e-postayi gondermez, yutar;
# kimse onay veya sifre sifirlama postasini alamaz.
#
# Ucretsiz secenekler: Brevo, Resend, Mailgun, SendGrid.
# Gmail'in kendi SMTP'si gunluk sinirlar ve "uygulama sifresi"
# gerektirdigi icin uygun degil.
#
# From adresi, SMTP saglayicisinda DOGRULANMIS bir adres olmali;
# degilse saglayici gondermeyi reddeder veya postalar spam'e duser.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=bilet@example.com
SMTP_FROM_NAME=Biletim
SMTP_USERNAME=DEGISTIR
SMTP_PASSWORD=DEGISTIR
# 587 -> STARTTLS kullanir, bu ayar false kalir.
# 465 -> bastan SSL; o zaman true yapin.
SMTP_USE_SSL=false
