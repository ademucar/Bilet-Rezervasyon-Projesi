# ===================================================================
# ORNEK ORTAM DEGISKENLERI
# ===================================================================
#
# KULLANIM:
#   cp .env.example .env
#   Sonra .env icindeki TUM sifreleri degistir.
#
# ONEMLI: .env dosyasi .gitignore'da -- ASLA commit'lenmez.
# Bu ornek dosya ise commit'lenir ki projeyi klonlayan kisi
# hangi degiskenlerin gerektigini bilsin.
#
# PDF Sprint 2: "Hassas bilgiler environment variable ile yonetilmelidir."
# ===================================================================

# ---------------- PostgreSQL ----------------
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=DEGISTIR_guclu_bir_sifre

# ---------------- Redis ----------------
REDIS_PASSWORD=DEGISTIR_guclu_bir_sifre

# ---------------- pgAdmin ----------------
PGADMIN_EMAIL=admin@ticketing.local
PGADMIN_PASSWORD=DEGISTIR_guclu_bir_sifre

# ---------------- Uygulama (Sprint 3'te kullanilacak) ----------------
# JWT imzalama anahtari.
# En az 32 karakter olmali -- HMAC-SHA256 icin 256 bit gerekiyor.
# Uretmek icin:  openssl rand -base64 48
JWT_SECRET=DEGISTIR_en_az_32_karakterlik_rastgele_bir_deger

JWT_ISSUER=Ticketing.Api
JWT_AUDIENCE=Ticketing.Client
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---------------- E-posta (Mailpit) ----------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@ticketing.local

# ---------------- Uygulama URL'leri ----------------
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ---------------- Host port eslemeleri ----------------
# Makinenizde bu portlar doluysa degistirin.
# Container ICINDEKI portlar degismez; yalnizca disari acilan port degisir.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# ------------------------------------------------------------------
# UYGULAMA ADRESLERI
# ------------------------------------------------------------------
# E-postalardaki baglantilar bunlarla uretiliyor (onay, sifre
# sifirlama). Kullanicinin TARAYICISINDAN acilacaklari icin Docker
# servis adi degil, disaridan gorunen adres yazilir.
#
# Yayina alirken kendi alan adinizla degistirin:
#   APP_URL_FRONTEND=https://biletim.example.com
#   APP_URL_API=https://api.biletim.example.com
# ------------------------------------------------------------------
APP_URL_FRONTEND=http://localhost:5173
APP_URL_API=http://localhost:5000
